                  "__name__": true,
                  "job": true,
                  "instance": true,
                  "namespace": true,
                  "pod": true,
                  "service": true,
                  "container": true,
                  "endpoint": true,
                  "node": true,
                  "gpu": true,
                  "GPU_I_ID": true
                }
