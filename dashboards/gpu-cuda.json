{
  "uid": "gpu-cuda",
  "title": "GPU CUDA Tracing (eBPF)",
  "description": "Per-pod CUDA API behaviour. Aggregated by k8s_namespace_name/k8s_pod_name.",
  "tags": [
    "gpu",
    "ebpf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ebpf_cuda_kernel_block_size_total_count",
      "description": "Per-pod CUDA API behaviour traced by uprobes. Labels are k8s_namespace_name and k8s_pod_name, NOT namespace/pod \u2014 those describe the scrape target and would attribute every workload to the agent.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (k8s_namespace_name, k8s_pod_name) (rate(ebpf_cuda_kernel_block_size_total_count[5m]))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ]
