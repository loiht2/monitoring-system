          "id": 14,
          "type": "timeseries",
          "title": "NVLink Transmission Throughput",
          "description": "Rate of data received by, and transmitted from, the GPU over NVLink. Requires NVLink-equipped GPUs. Some of these are not implemented on every GPU; an absent series means unsupported, not idle — see the Metric Support Matrix.",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_PROF_NVLINK_TX_BYTES{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
              "legendFormat": "{{node}} gpu{{gpu}} · tx"
            },
            {
              "expr": "DCGM_FI_PROF_NVLINK_RX_BYTES{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
              "legendFormat": "{{node}} gpu{{gpu}} · rx"
            }
          ]
        },
        {
          "id": 15,
          "type": "timeseries",
          "title": "Chip to Chip Bandwidth",
          "description": "Total bytes received over, and transmitted over, the chip-to-chip link. Requires a Grace-coupled platform. Some of these are not implemented on every GPU; an absent series means unsupported, not idle — see the Metric Support Matrix.",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_PROF_C2C_TX_ALL_BYTES{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
              "legendFormat": "{{node}} gpu{{gpu}} · tx"
            },
            {
              "expr": "DCGM_FI_PROF_C2C_RX_ALL_BYTES{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
              "legendFormat": "{{node}} gpu{{gpu}} · rx"
            }
          ]
