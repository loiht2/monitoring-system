            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_DEV_SM_CLOCK{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"} * 1000000",
              "legendFormat": "{{node}} gpu{{gpu}} · sm"
            },
            {
              "expr": "DCGM_FI_DEV_MEM_CLOCK{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"} * 1000000",
              "legendFormat": "{{node}} gpu{{gpu}} · mem"
            }
          ]
        },
        {
          "id": 19,
          "type": "state-timeline",
          "title": "Clocks Throttle Reasons",
          "description": "Fraction of the interval each throttle reason was active.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "lineWidth": 0,
                "fillOpacity": 70
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
