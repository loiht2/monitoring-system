        {
          "id": 19,
          "type": "state-timeline",
          "title": "Clock Throttle Reasons",
          "description": "Whether each clock-limiting reason is currently active.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "lineWidth": 0,
                "fillOpacity": 70
