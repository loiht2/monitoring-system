    {
      "id": 27,
      "type": "row",
      "title": "Allocation & Support",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [
        {
          "id": 20,
          "type": "table",
          "title": "Entitlement",
          "description": "The pod granted this device. Constant 1; the identity is in the labels.",
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "targets": [
            {
              "expr": "gpu_alloc_device_pod_info{gpu_uuid=~\"$gpu\"}",
              "instant": true,
              "format": "table"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
