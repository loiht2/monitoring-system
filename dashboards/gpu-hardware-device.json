                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Inactive",
                      "color": "green",
                      "index": 0
                    },
                    "1": {
                      "text": "Active",
                      "color": "red",
                      "index": 1
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "mergeValues": true,
            "showValue": "auto",
            "alignValue": "center",
