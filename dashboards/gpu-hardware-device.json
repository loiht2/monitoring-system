{
  "uid": "gpu-hardware-device",
  "title": "GPU Hardware — Device",
  "description": "What a whole physical card is doing, who holds it, and whether it is healthy. DCGM is the source for device readings; NVML is retained for exactly three panels DCGM cannot supply (GPU Utilization per Pod, Memory Held by Each Pod, Clocks Throttle Reasons). Every DCGM panel filters to the whole-device entity (GPU_I_ID=\"\") and every retained nvml_* panel filters to the whole-device reading (mig_uuid=\"\"), so a MIG-partitioned card's instance-scoped reading is never double-counted into a device total; see GPU Hardware — MIG for the per-instance view.",
  "tags": [
    "gpu",
    "hardware",
    "device"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gpu-prometheus"
        },
        "query": "label_values(gpu_uuid)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 30,
      "type": "row",
      "title": "Performance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "GPU Utilization",
      "description": "Percent of time the GPU was actively processing.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"} / 100",
          "legendFormat": "{{node}} gpu{{gpu}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU Utilization per Pod",
      "description": "GPU utilization per process, summed per pod.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (namespace, pod, gpu_uuid) (nvml_process_sm_utilization_ratio{gpu_uuid=~\"$gpu\", mig_uuid=\"\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SM Activity",
      "description": "Percent of cycles where an SM had at least one warp resident.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SM Occupancy",
      "description": "Percent of number of warps resident on an SM. Normalized to the MIG instance, not the card: never sum these into a device total.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_OCCUPANCY{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tensor Core Utilization",
      "description": "Percent of cycles when any tensor pipe was active, and per pipe: HMMA, IMMA, DFMA. Some of these are not implemented on every GPU; an absent series means unsupported, not idle — see the Metric Support Matrix. Normalized to the MIG instance, not the card: never sum these into a device total.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · tensor (all)"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_HMMA_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · HMMA"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_IMMA_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · IMMA"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_DFMA_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · DFMA"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "FP & Integer Utilization",
      "description": "Percent of cycles when the FP64, FP32, FP16 and integer pipes were active. Some of these are not implemented on every GPU; an absent series means unsupported, not idle — see the Metric Support Matrix. Normalized to the MIG instance, not the card: never sum these into a device total.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PIPE_FP64_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · FP64"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP32_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · FP32"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP16_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · FP16"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_INT_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · integer"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache Hit Rates",
      "description": "Percent of requests to host memory and to peer memory that were cache hits. Host-memory hits require a Grace-coupled platform; peer-memory hits require NVLink-equipped GPUs. Some of these are not implemented on every GPU; an absent series means unsupported, not idle — see the Metric Support Matrix.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_HOSTMEM_CACHE_HIT{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · host"
        },
        {
          "expr": "DCGM_FI_PROF_PEERMEM_CACHE_HIT{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · peer"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cache Miss Rates",
      "description": "Percent of requests to host memory and to peer memory that were cache misses. Host-memory misses require a Grace-coupled platform; peer-memory misses require NVLink-equipped GPUs. Some of these are not implemented on every GPU; an absent series means unsupported, not idle — see the Metric Support Matrix.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_HOSTMEM_CACHE_MISS{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · host"
        },
        {
          "expr": "DCGM_FI_PROF_PEERMEM_CACHE_MISS{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · peer"
        }
      ]
    },
    {
      "id": 31,
      "type": "row",
      "title": "Memory",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "panels": [
        {
          "id": 9,
          "type": "bargauge",
          "title": "Memory Used vs Total",
          "description": "Memory in use, against the memory installed on the card. Normalized to the MIG instance, not the card: never sum these into a device total. DCGM reports framebuffer in MiB.",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 0.85
                  },
                  {
                    "color": "red",
                    "value": 0.95
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "horizontal",
            "displayMode": "gradient",
            "showUnfilled": true
          },
          "targets": [
            {
              "expr": "DCGM_FI_DEV_FB_USED{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"} / (DCGM_FI_DEV_FB_USED{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"} + DCGM_FI_DEV_FB_FREE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"})",
              "legendFormat": "{{node}} gpu{{gpu}}",
              "instant": true
            }
          ]
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "Memory Used Over Time",
          "description": "Memory in use. Normalized to the MIG instance, not the card: never sum these into a device total. DCGM reports framebuffer in MiB.",
          "gridPos": {
            "h": 8,
            "w": 16,
            "x": 8,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_DEV_FB_USED{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"} * 1048576",
              "legendFormat": "{{node}} gpu{{gpu}} · used"
            }
          ]
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "Memory Held by Each Pod",
          "description": "Memory in use per process, summed per pod. Normalized to the MIG instance, not the card: never sum these into a device total.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (namespace, pod, gpu_uuid) (nvml_process_gpu_memory_bytes{gpu_uuid=~\"$gpu\", mig_uuid=\"\"})",
              "legendFormat": "{{namespace}}/{{pod}}"
            }
          ]
        },
        {
          "id": 12,
          "type": "timeseries",
          "title": "Memory Bandwidth Utilization",
          "description": "Percent of cycles the device memory interface is active. Normalized to the MIG instance, not the card: never sum these into a device total.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_PROF_DRAM_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID=\"\"}",
              "legendFormat": "{{node}} gpu{{gpu}}"
            }
          ]
        }
      ]
    },
