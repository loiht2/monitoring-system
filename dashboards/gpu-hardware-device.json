    {
      "id": 34,
      "type": "row",
      "title": "Clocks",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": [
        {
          "id": 18,
          "type": "timeseries",
          "title": "Clock Frequencies",
          "description": "Current SM and memory clock frequency in MHz.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "hertz",
              "custom": {
                "fillOpacity": 8
