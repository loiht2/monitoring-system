{
  "uid": "gpu-per-pod",
  "title": "GPU Per-Pod (NVML)",
  "description": "Per-pod and device readings from NVML. The only source with per-process hardware numbers.",
  "tags": [
    "gpu",
    "nvml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "nvml_gpu_clock_hertz",
      "description": "Device-level reading from NVML. Absent rather than zero when the GPU cannot report it.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvml_gpu_clock_hertz",
          "legendFormat": "{{gpu_uuid}}"
        }
      ]
    },
    {
