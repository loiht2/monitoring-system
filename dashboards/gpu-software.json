{
  "uid": "gpu-software",
  "title": "GPU Software — eBPF",
  "description": "What each pod asks CUDA to do, and where it waits — entirely eBPF-sourced (kernel launches, memory operations, synchronization, HAMi interception).",
  "tags": [
    "gpu",
    "ebpf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gpu-prometheus"
        },
        "query": "label_values(ebpf_cuda_kernel_launch_calls_total, k8s_pod_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gpu-prometheus"
        },
        "query": "label_values(gpu_uuid)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total CUDA Kernel Launches",
      "description": "Total kernels launched by the selected pods and GPUs across the current time window.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(ebpf_cuda_kernel_launch_calls_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__range]))",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total CUDA Errors",
      "description": "Total failed CUDA driver calls (non-zero return code) in the window, across every probed function.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(ebpf_cuda_errors_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__range]))",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total HAMi OOM Events",
      "description": "Total allocations HAMi's interception library refused because a pod exceeded its memory quota.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(ebpf_hami_oom_events_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__range]))",
          "range": true
        }
      ]
    },
    {
      "id": 29,
      "type": "row",
      "title": "1. Compute Activity",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": [
        {
          "id": 5,
          "type": "timeseries",
          "title": "CUDA Kernel Launch Rate",
          "description": "Kernels submitted to the GPU per second, per pod",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "custom": {
                "fillOpacity": 8
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, k8s_pod_uid, gpu_uuid) (rate(ebpf_cuda_kernel_launch_calls_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval]))",
              "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        },
        {
          "id": 6,
          "type": "timeseries",
          "title": "CUDA Graph Launch Rate",
          "description": "How often the workload replays a captured CUDA Graph (cuGraphLaunch)",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 12,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "custom": {
                "fillOpacity": 8
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, k8s_pod_uid, gpu_uuid) (rate(ebpf_cuda_graph_launch_calls_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval]))",
              "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        },
        {
          "id": 7,
          "type": "heatmap",
          "title": "Host-Side CUDA Kernel Launch Latency Distribution",
          "description": "Full distribution of how long the HOST waited inside the launch call, across the selected pods.",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 0,
            "y": 9
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "scaleDistribution": {
                  "type": "linear"
                }
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "calculate": false,
            "cellGap": 1,
            "color": {
              "mode": "scheme",
              "scheme": "Spectral",
              "steps": 64,
              "reverse": false,
              "fill": "dark"
            },
            "yAxis": {
              "unit": "s",
              "axisPlacement": "left"
            },
            "legend": {
              "show": true
            },
            "tooltip": {
              "show": true,
              "yHistogram": false
            }
          },
          "targets": [
            {
              "expr": "sum by (le) (rate(ebpf_cuda_kernel_launch_duration_seconds_bucket{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval]))",
              "format": "heatmap",
              "legendFormat": "{{le}}"
            }
          ]
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Host-Side CUDA Kernel Launch Latency P95/P99",
          "description": "How long the HOST waited to submit work, not GPU runtime",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 12,
            "y": 9
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "fillOpacity": 8
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum by (k8s_namespace_name, k8s_pod_name, k8s_pod_uid, gpu_uuid, le) (rate(ebpf_cuda_kernel_launch_duration_seconds_bucket{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval])))",
              "legendFormat": "P95 | {{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            },
            {
              "expr": "histogram_quantile(0.99, sum by (k8s_namespace_name, k8s_pod_name, k8s_pod_uid, gpu_uuid, le) (rate(ebpf_cuda_kernel_launch_duration_seconds_bucket{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval])))",
              "legendFormat": "P99 | {{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        },
        {
          "id": 9,
          "type": "table",
          "title": "Pods Ranked by CUDA Activity",
          "description": "Every pod that launched at least one CUDA kernel in the selected window, ranked by launch count",
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 18
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, k8s_owner_name, gpu_uuid) (increase(ebpf_cuda_kernel_launch_calls_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__range]))",
              "format": "table",
              "instant": true
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "renameByName": {
                  "Value": "CUDA Kernel Launches (window)",
                  "k8s_namespace_name": "Namespace",
                  "k8s_pod_name": "Pod",
                  "k8s_owner_name": "Owner",
                  "gpu_uuid": "GPU UUID"
                }
              }
            }
          ],
          "options": {
            "cellHeight": "sm",
            "showHeader": true,
            "sortBy": [
              {
                "desc": true,
                "displayName": "CUDA Kernel Launches (window)"
              }
            ]
          }
        }
      ]
    },
