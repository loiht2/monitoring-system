          "targets": [
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, k8s_pod_uid, gpu_uuid) (rate(ebpf_cuda_memory_allocations_bytes_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval])) / clamp_min(sum by (k8s_namespace_name, k8s_pod_name, k8s_pod_uid, gpu_uuid) (rate(ebpf_cuda_memory_allocations_calls_total{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\"}[$__rate_interval])), 1)",
