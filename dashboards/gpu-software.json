        {
          "id": 15,
          "type": "timeseries",
          "title": "Memory Copy Traffic by Direction",
          "description": "Data movement per second, split by direction (cuda_memcpy_kind). Host-to-device bytes are usually the input pipeline; sustained high copy with low kernel activity in Compute Activity means the GPU is being starved. Device-to-device dominates during NCCL all-reduce in multi-GPU training.",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 12,
            "y": 18
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "custom": {
                "fillOpacity": 8
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, gpu_uuid, cuda_memcpy_kind) (rate(ebpf_cuda_memory_copies_bytes_total_sum{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\",cuda_memcpy_kind=~\"MemcpyHostToDevice\"}[$__rate_interval]))",
              "legendFormat": "Host→Device | {{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            },
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, gpu_uuid, cuda_memcpy_kind) (rate(ebpf_cuda_memory_copies_bytes_total_sum{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\",cuda_memcpy_kind=~\"MemcpyDeviceToHost\"}[$__rate_interval]))",
              "legendFormat": "Device→Host | {{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            },
            {
              "expr": "sum by (k8s_namespace_name, k8s_pod_name, gpu_uuid, cuda_memcpy_kind) (rate(ebpf_cuda_memory_copies_bytes_total_sum{k8s_pod_name=~\"$pod\",gpu_uuid=~\"$gpu\",cuda_memcpy_kind=~\"MemcpyDeviceToDevice\"}[$__rate_interval]))",
              "legendFormat": "Device→Device | {{k8s_namespace_name}}/{{k8s_pod_name}} [{{gpu_uuid}}]"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        },
        {
          "id": 16,
          "type": "timeseries",
          "title": "Memset Traffic — Sync vs Async",
          "description": "Bytes/second cleared on the device (cudaMemset / cudaMemsetAsync), split by whether the call blocks the host. High sync-memset rates are often wasteful buffer re-initialisation that could be replaced with the async form or with reuse.",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 0,
            "y": 27
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "custom": {
                "fillOpacity": 8
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
