{
  "uid": "gpu-compute",
  "title": "GPU Compute",
  "tags": [
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gpu",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gpu-prometheus"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, gpu_uuid)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Engine active",
      "description": "Ratio of time the graphics/compute engine was active. Stricter than GPU utilization, and the measure that stays valid under MIG.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "{{gpu_uuid}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SM active vs occupancy",
      "description": "SM active is the fraction of cycles at least one warp was resident. Occupancy is resident warps against the hardware maximum. High occupancy does not imply efficient work.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "active {{gpu_uuid}}"
        },
        {
          "expr": "DCGM_FI_PROF_SM_OCCUPANCY{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "occupancy {{gpu_uuid}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Compute pipes",
      "description": "Which arithmetic units the workload is using. High FP32 with near-zero tensor activity in a training job usually means mixed precision is not engaged. A pipe with no line is explained by the note below: unsupported on this GPU, or genuinely idle.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "tensor (any)"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_HMMA_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "tensor HMMA fp16/bf16"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_IMMA_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "tensor IMMA int8"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP32_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "fp32"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP16_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "fp16"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP64_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "fp64"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_INT_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "int"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory bandwidth vs compute",
      "description": "DRAM active is the memory-bandwidth measure. High DRAM with low SM activity means the workload is memory-bound.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_DRAM_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "dram {{gpu_uuid}}"
        },
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "sm {{gpu_uuid}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PCIe throughput",
      "description": "Host-to-device traffic is usually the input pipeline. Rising RX with flat SM activity means the GPU is being starved.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PCIE_RX_BYTES{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "rx {{gpu_uuid}}"
        },
        {
          "expr": "DCGM_FI_PROF_PCIE_TX_BYTES{gpu_uuid=~\"$gpu\"}",
          "legendFormat": "tx {{gpu_uuid}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "",
      "description": "Metrics this GPU cannot report. Empty means every metric on the panel above is supported; a supported metric with no line is idle, not broken.",
      "gridPos": {
        "h": 2,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": " "
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\", metric=~\"DCGM_FI_PROF_GR_ENGINE_ACTIVE\"} == 0",
          "legendFormat": "{{metric}} \u2014 not supported on this GPU",
          "instant": true
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "",
      "description": "Metrics this GPU cannot report. Empty means every metric on the panel above is supported; a supported metric with no line is idle, not broken.",
      "gridPos": {
        "h": 2,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": " "
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\", metric=~\"DCGM_FI_PROF_SM_ACTIVE|DCGM_FI_PROF_SM_OCCUPANCY\"} == 0",
          "legendFormat": "{{metric}} \u2014 not supported on this GPU",
          "instant": true
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "",
      "description": "Metrics this GPU cannot report. Empty means every metric on the panel above is supported; a supported metric with no line is idle, not broken.",
      "gridPos": {
        "h": 2,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": " "
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\", metric=~\"DCGM_FI_PROF_PIPE_.*\"} == 0",
          "legendFormat": "{{metric}} \u2014 not supported on this GPU",
          "instant": true
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "",
      "description": "Metrics this GPU cannot report. Empty means every metric on the panel above is supported; a supported metric with no line is idle, not broken.",
      "gridPos": {
        "h": 2,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": " "
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\", metric=~\"DCGM_FI_PROF_DRAM_ACTIVE|DCGM_FI_PROF_SM_ACTIVE\"} == 0",
          "legendFormat": "{{metric}} \u2014 not supported on this GPU",
          "instant": true
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "",
      "description": "Metrics this GPU cannot report. Empty means every metric on the panel above is supported; a supported metric with no line is idle, not broken.",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": " "
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\", metric=~\"DCGM_FI_PROF_PCIE_.*\"} == 0",
          "legendFormat": "{{metric}} \u2014 not supported on this GPU",
          "instant": true
        }
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "Metric support",
      "description": "Which metrics each GPU can produce. 'Not supported on this GPU' is a hardware or driver limitation, not a fault. A metric missing from this table entirely has unknown support \u2014 the exporter could not determine it, and nothing is claimed.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "targets": [
        {
          "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true,
              "endpoint": true,
              "node": true,
              "gpu": true,
              "GPU_I_ID": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not supported on this GPU",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "Supported",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    }
  ]
}