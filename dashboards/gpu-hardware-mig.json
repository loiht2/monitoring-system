{
  "uid": "gpu-hardware-mig",
  "title": "GPU Hardware — MIG",
  "description": "Per-instance view of a MIG-partitioned card: every panel here reports one GPU instance, not the whole physical device. Field definitions are shared with GPU Hardware — Device (the scope is the only difference between them). Utilization here is normalized to the instance, not the card, so a saturated instance can read close to 1.0 while the rest of the physical card sits idle — instance values must never be summed into a device-level figure. A MIG series carries gpu_uuid for the parent card, mig_uuid for the instance, and GPU_I_ID, which is the only identifier DCGM publishes for an instance.",
  "tags": [
    "gpu",
    "hardware",
    "mig"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gpu-prometheus"
        },
        "query": "label_values(gpu_uuid)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Performance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "GPU Utilization",
      "description": "Percent of time the MIG instance was actively processing.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SM Efficiency",
      "description": "Percent of cycles where an SM had at least one warp resident.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SM Occupancy",
      "description": "Percent of number of warps resident on an SM.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_SM_OCCUPANCY{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tensor Core Utilization",
      "description": "Percent of cycles when any tensor pipe was active, and per pipe: HMMA, IMMA, DFMA.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · tensor (all)"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_HMMA_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · HMMA"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_IMMA_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · IMMA"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_DFMA_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · DFMA"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "FP & Integer Utilization",
      "description": "Percent of cycles when the FP64, FP32, FP16 and integer pipes were active.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PIPE_FP64_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · FP64"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP32_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · FP32"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_FP16_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · FP16"
        },
        {
          "expr": "DCGM_FI_PROF_PIPE_INT_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
          "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · integer"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Memory",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "panels": [
        {
          "id": 6,
          "type": "bargauge",
          "title": "Memory Used vs Total",
          "description": "Memory in use, against the memory installed on the card.",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 0.85
                  },
                  {
                    "color": "red",
                    "value": 0.95
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "horizontal",
            "displayMode": "gradient",
            "showUnfilled": true
          },
          "targets": [
            {
              "expr": "DCGM_FI_DEV_FB_USED{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"} / (DCGM_FI_DEV_FB_USED{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"} + DCGM_FI_DEV_FB_FREE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"})",
              "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}}",
              "instant": true
            }
          ]
        },
        {
          "id": 7,
          "type": "timeseries",
          "title": "Memory Used Over Time",
          "description": "Memory in use.",
          "gridPos": {
            "h": 8,
            "w": 16,
            "x": 8,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_DEV_FB_USED{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"} * 1048576",
              "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}} · used"
            }
          ]
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Memory Held by Each Pod",
          "description": "Memory in use per process, summed per pod.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (namespace, pod, gpu_uuid, mig_uuid) (nvml_process_gpu_memory_bytes{gpu_uuid=~\"$gpu\", mig_uuid!=\"\"})",
              "legendFormat": "{{namespace}}/{{pod}} · {{mig_uuid}}"
            }
          ]
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Memory Bandwidth Utilization",
          "description": "Percent of cycles the device memory interface is active.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "custom": {
                "fillOpacity": 8
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "DCGM_FI_PROF_DRAM_ACTIVE{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
              "legendFormat": "{{node}} gpu{{gpu}} · {{GPU_I_PROFILE}}"
            }
          ]
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Support",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "panels": [
        {
          "id": 13,
          "type": "table",
          "title": "Metric Support Matrix",
          "description": "Whether an entity can produce a metric: 1 supported, 0 not supported, absent when unknown.",
          "gridPos": {
            "h": 14,
            "w": 24,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-prometheus"
          },
          "targets": [
            {
              "expr": "gpu_metric_supported{gpu_uuid=~\"$gpu\", GPU_I_ID!=\"\"}",
              "instant": true,
              "format": "table"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "job": true,
                  "instance": true,
                  "namespace": true,
                  "pod": true,
                  "service": true,
                  "container": true,
                  "endpoint": true,
                  "node": true,
                  "gpu": true
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Not supported on this GPU",
                      "color": "text",
                      "index": 0
                    },
                    "1": {
                      "text": "Supported",
                      "color": "green",
                      "index": 1
                    }
                  }
                }
              ]
            },
            "overrides": []
          }
        }
      ]
    }
  ]
}
